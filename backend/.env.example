DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/alimenta_mais?sslmode=disable
HTTP_ADDR=:8080
ALLOWED_ORIGIN=http://localhost:5173

# Gere uma chave aleatória de pelo menos 32 bytes. Nunca versione a chave real.
JWT_SECRET=

# false somente no HTTP local; em HTTPS use true.
COOKIE_SECURE=false

# Usadas somente pelo comando de criação do primeiro administrador.
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
